     ]
    }
   ],
   "source": [
    "# ============================================================\n",
    "# Seed-Alpha Generation Pipeline (Resume 지원)\n",
    "# - LLM으로 simple seed-alpha 후보 생성\n",
    "# - is_valid_seed_alpha()로 구조 필터링 후 시뮬레이션\n",
    "# - 결과를 per-dataset .txt 파일로 저장 (incremental append)\n",
    "#\n",
    "# SELECTION: sharpe > 1.5 AND fail_count in {0, 1}\n",
    "# SORTING:   fail_count ASC, sharpe DESC\n",
    "# DEDUP:     by expression (same expression not saved twice)\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "# 🔧 CONFIG\n",
    "TOP_N_DATAFIELDS = 10    # 각 dataset에서 alphaCount 상위 N개만 LLM에 전달\n",
    "SEED_ALPHA_NUM = 100     # LLM에게 요청할 알파 개수 per batch\n",
    "OUTPUT_DIR = '.'         # .txt 파일 저장 디렉토리\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Resume 지원 함수들 (원본 유지)\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def get_existing_json_count(dataset, gen_dir=\"./gen_json\"):\n",
    "    if not os.path.exists(gen_dir):\n",
    "        os.makedirs(gen_dir, exist_ok=True)\n",
    "        return 0\n",
    "    pattern = re.compile(rf\"^{re.escape(dataset)}_(\\d+)\\.json$\")\n",
    "    count = 0\n",
    "    for filename in os.listdir(gen_dir):\n",
    "        if pattern.match(filename):\n",
    "            count += 1\n",
    "    return count\n",
    "\n",
    "\n",
    "def get_next_json_index(dataset, gen_dir=\"./gen_json\"):\n",
    "    if not os.path.exists(gen_dir):\n",
    "        os.makedirs(gen_dir, exist_ok=True)\n",
    "        return 0\n",
    "    pattern = re.compile(rf\"^{re.escape(dataset)}_(\\d+)\\.json$\")\n",
    "    max_k = -1\n",
    "    for filename in os.listdir(gen_dir):\n",
    "        match = pattern.match(filename)\n",
    "        if match:\n",
    "            k = int(match.group(1))\n",
    "            if k > max_k:\n",
    "                max_k = k\n",
    "    return max_k + 1\n",
    "\n",
    "\n",
    "def save_json_safe(data, filepath):\n",
    "    if os.path.exists(filepath):\n",
    "        print(f\"[WARN] File already exists, skipping: {filepath}\")\n",
    "        return False\n",
    "    with open(filepath, 'w', encoding='utf-8') as f:\n",
    "        json.dump(data, f, ensure_ascii=False, indent=2)\n",
    "    return True\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Helper: operators_list.json → compact string for LLM prompt\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def format_operators_compact(operators_dict):\n",
    "    \"\"\"\n",
    "    operators_list.json을 카테고리별로 정리하여 compact string으로 변환.\n",
    "    LLM 프롬프트의 OPERATORS_LIST 섹션에 사용.\n",
    "    \"\"\"\n",
    "    ops_by_category = {}\n",
    "    for op_name, op_info in operators_dict.items():\n",
    "        cat = op_info.get('category', 'Other')\n",
    "        if cat not in ops_by_category:\n",
    "            ops_by_category[cat] = []\n",
    "        ops_by_category[cat].append(op_info.get('definition', op_name))\n",
    "\n",
    "    lines = []\n",
    "    for cat, defs in ops_by_category.items():\n",
    "        lines.append(f\"[{cat}] \" + \" | \".join(defs))\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# NEW: Seed-alpha LLM prompt & generation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def generate_seed_expressions(s, alpha_region, alpha_universe, dataset_id,\n",
    "                               model='gpt-5-mini-2025-08-07',\n",
    "                               alpha_num=100,\n",
    "                               top_n_datafields=10):\n",
    "    \"\"\"\n",
    "    Generate seed-alpha candidates via LLM.\n",
    "    ~70-80% follow 4 strict seed patterns, ~20-30% use free-form operators from operators_list.json.\n",
    "    Returns raw LLM response string.\n",
    "    \"\"\"\n",
    "    # Get datafields for this dataset\n",
    "    data_fields = ace.get_datafields(\n",
    "        s, region=alpha_region, universe=alpha_universe,\n",
    "        dataset_id=dataset_id, data_type='ALL'\n",
    "    )\n",
    "    data_fields = data_fields[data_fields['type'] != \"GROUP\"]\n",
    "\n",
    "    # Top N by alphaCount\n",
    "    top_fields_df = data_fields.nlargest(top_n_datafields, \"alphaCount\")\n",
    "\n",
    "    # Compact spec for LLM\n",
    "    spec_keys = ['id', 'description', 'coverage', 'userCount', 'alphaCount', 'type']\n",
    "    available_keys = [k for k in spec_keys if k in top_fields_df.columns]\n",
    "    selected_datafields_spec = top_fields_df[available_keys].to_dict(\"records\")\n",
    "\n",
    "    print(f\"[INFO] Selected top {len(selected_datafields_spec)} datafields for dataset '{dataset_id}':\")\n",
    "    for df_spec in selected_datafields_spec:\n",
    "        print(f\"  - {df_spec.get('id', 'N/A')} (alphaCount: {df_spec.get('alphaCount', 'N/A')}, type: {df_spec.get('type', 'N/A')})\")\n",
    "\n",
    "    # Load operators list for FREE_PATTERN section\n",
    "    operators_dict = llm.import_json('operators_list.json')\n",
    "    operators_compact = format_operators_compact(operators_dict)\n",
    "\n",
    "    answer_form = '''{\n",
    "\"results\":[\n",
    "    {\n",
    "        \"idea\":...,\n",
    "        \"description\":...,\n",
    "        \"implementation\":...,\n",
    "        \"confidence_level\":...\n",
    "    }\n",
    "]\n",
    "}'''\n",
    "\n",
    "    prompt = f\"\"\"\n",
    "<MISSION>\n",
    "Based on the ALLOWED_PATTERNS, FREE_PATTERN, and ALLOWED_DATAFIELDS below,\n",
    "generate {alpha_num} SEPARATED and DIVERSIFIED simple seed-alpha expressions.\n",
    "\n",
    "Each result must have 4 parts:\n",
    "- \"idea\": core idea of the alpha\n",
    "- \"description\": which pattern you used, which datafield, which window parameter, and why\n",
    "- \"implementation\": the FASTEXPR expression\n",
    "- \"confidence_level\": 0-1 scale, higher = more confident\n",
    "</MISSION>\n",
    "\n",
    "<GENERATION_RATIO>\n",
    "- About 70-80% of generated alphas MUST follow one of the 4 ALLOWED_PATTERNS exactly.\n",
    "- About 20-30% of generated alphas may use FREE_PATTERN: creative combinations of operators from OPERATORS_LIST.\n",
    "</GENERATION_RATIO>\n",
    "\n",
    "<ALLOWED_PATTERNS>\n",
    "These 4 patterns are the primary building blocks (use for ~70-80% of alphas):\n",
    "\n",
    "Pattern 1 - Backfill: ts_backfill(DATA, window)\n",
    "  Example: ts_backfill(rsk60_offer, 252)\n",
    "  Use when: coverage < 0.6, to fill missing data\n",
    "\n",
    "Pattern 2 - Time-series Z-score: ts_zscore(DATA, window)\n",
    "  Example: ts_zscore(mdl138_4idpc, 252)\n",
    "  If DATA is VECTOR type, wrap with vec_avg(): ts_zscore(vec_avg(rsk60_offer), 252)\n",
    "  Use when: normalize signal over time\n",
    "\n",
    "Pattern 3 - Cross-sectional Scale Normalization: rank or zscore of DATA\n",
    "  Intent: remove scale/size effects without using market cap (cap is NOT available).\n",
    "  Approaches (pick one):\n",
    "    - rank(DATA): pure cross-sectional rank (simplest, 1 operator)\n",
    "    - zscore(rank(DATA)): ranked then standardized (2 operators)\n",
    "    - ts_zscore(rank(DATA), window): temporal z-score of ranked signal (2 operators)\n",
    "  Example: ts_zscore(rank(mdl25_vrv421_81v), 126)\n",
    "  Use when: the raw signal has large cross-sectional dispersion or scale bias\n",
    "\n",
    "Pattern 4 - Bucket-based Group Normalization: group_zscore with bucket grouping\n",
    "  Intent: normalize within peer-like groups to reduce concentration.\n",
    "  IMPORTANT: `industry` and `sector` are NOT available. Use bucket() to build groups.\n",
    "  The group argument MUST be: bucket(rank(DATA), buckets=N) where N is 5..20.\n",
    "  Example: group_zscore(DATA, bucket(rank(DATA), buckets=10))\n",
    "  Use when: signal benefits from within-group normalization\n",
    "  NOTE: this uses 3 operators (group_zscore, bucket, rank) at max allowed depth.\n",
    "</ALLOWED_PATTERNS>\n",
    "\n",
    "<BANNED_FIELDS>\n",
    "These field names DO NOT EXIST in Brain and WILL cause simulation errors:\n",
    "- cap, market_cap, mktcap\n",
    "- industry, sector, subindustry\n",
    "NEVER use these as datafields or as group arguments.\n",
    "For scale normalization: use rank() or zscore() instead of dividing by cap.\n",
    "For group normalization: use bucket(rank(DATA), buckets=N) as the group argument.\n",
    "</BANNED_FIELDS>\n",
    "\n",
    "<FREE_PATTERN>\n",
    "For about 20-30% of generated alphas, you may create expressions using any combination\n",
    "of operators from OPERATORS_LIST below. Be creative and explore different operator combos.\n",
    "\n",
    "These free-form expressions must still follow STRUCTURAL LIMITS:\n",
    "- Maximum 3 operators per expression\n",
    "- Only 1 signal datafield from ALLOWED_DATAFIELDS (no other fields allowed)\n",
    "- NEVER use cap, industry, sector, subindustry (they do not exist)\n",
    "- VECTOR type fields must use vec_* operators (vec_avg, vec_sum, vec_max, etc.)\n",
    "- Time-series window parameters: use values between 5 and 252\n",
    "\n",
    "Examples of free patterns:\n",
    "- ts_rank(DATA, 63)\n",
    "- quantile(ts_delta(DATA, 21))\n",
    "- ts_decay_linear(DATA, 126)\n",
    "- zscore(ts_mean(DATA, 63))\n",
    "- ts_ir(DATA, 126)\n",
    "- winsorize(ts_zscore(DATA, 63))\n",
    "- rank(ts_kurtosis(DATA, 126))\n",
    "- group_zscore(DATA, bucket(rank(DATA), buckets=10))\n",
    "</FREE_PATTERN>\n",
    "\n",
    "<OPERATORS_LIST>\n",
    "{operators_compact}\n",
    "</OPERATORS_LIST>\n",
    "\n",
    "<STRICT_RULES>\n",
    "RULE1: You MUST ONLY use datafield IDs from ALLOWED_DATAFIELDS. No other datafields.\n",
    "RULE2: Each expression must use exactly ONE signal datafield from ALLOWED_DATAFIELDS.\n",
    "RULE3: If a datafield has type=VECTOR, you MUST wrap it with vec_avg() or other vec_* operators before using.\n",
    "RULE4: Window parameters should be diverse: use various values between 5 and 252.\n",
    "RULE5: Maximum 3 operators per expression. Keep it simple.\n",
    "RULE6: NEVER use cap, industry, sector, or subindustry -- they do not exist in Brain.\n",
    "RULE7: For group_* operators, the group argument MUST be bucket(rank(DATA), buckets=N) with N in 5..20.\n",
    "</STRICT_RULES>\n",
    "\n",
    "<DIVERSITY_GUIDANCE>\n",
    "- Use ALL available datafields, not just the top one\n",
    "- Vary window parameters (5, 10, 21, 42, 63, 126, 189, 252, etc.)\n",
    "- Mix ALLOWED_PATTERNS and FREE_PATTERN\n",
    "- For VECTOR fields, always wrap with vec_* operators\n",
    "- For low-coverage fields (coverage < 0.6), prefer Pattern 1 (ts_backfill)\n",
    "</DIVERSITY_GUIDANCE>\n",
    "\n",
    "<ALLOWED_DATAFIELDS>\n",
    "{selected_datafields_spec}\n",
    "</ALLOWED_DATAFIELDS>\n",
    "\n",
    "<ANSWER_FORMAT>\n",
    "You must answer in this form:\n",
    "{answer_form}\n",
    "</ANSWER_FORMAT>\n",
    "\"\"\".strip()\n",
    "\n",
    "    result_json = llm.call_llm_stream(prompt, answer_form, model)\n",
    "    return result_json\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 메인 루프 (Seed-Alpha Pipeline)\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "GEN_DIR = \"./gen_json\"\n",
    "os.makedirs(GEN_DIR, exist_ok=True)\n",
    "\n",
    "# 🔧 REGION / UNIVERSE from global variables\n",
    "region = REGION\n",
    "universe = UNIVERSE\n",
    "\n",
    "print(f\"[CONFIG] Region: {region}, Universe: {universe}\")\n",
    "print(f\"[CONFIG] Using top {TOP_N_DATAFIELDS} datafields per dataset\")\n",
    "print(f\"[CONFIG] Selection: sharpe > 1.5 AND fail_count <= 1\")\n",
    "print(f\"[CONFIG] Sorting: fail_count ASC, sharpe DESC | Dedup by expression\")\n",
    "print(f\"[CONFIG] Datasets: {datasets_list}\")\n",
    "\n",
    "for dataset in datasets_list:\n",
    "    \n",
    "    # 목표 생성 횟수\n",
    "    target_simnum = dataset_to_simnum(dataset)\n",
    "    \n",
    "    # 현재 존재하는 파일 개수\n",
    "    existing_count = get_existing_json_count(dataset, GEN_DIR)\n",
    "    \n",
    "    # 남은 생성 횟수\n",
    "    remaining = target_simnum - existing_count\n",
    "    \n",
    "    # 다음 저장할 인덱스\n",
    "    start_index = get_next_json_index(dataset, GEN_DIR)\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"[DATASET] {dataset}\")\n",
    "    print(f\"  existing={existing_count}  target={target_simnum}  remaining={remaining}  start_index={start_index}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    if remaining <= 0:\n",
    "        print(f\"[SKIP] dataset={dataset} already complete ({existing_count}/{target_simnum})\")\n",
    "        continue\n",
    "    \n",
    "    # Load existing .txt records for this dataset (for incremental merge)\n",
    "    all_records = load_existing_txt_records(dataset, OUTPUT_DIR)\n",
    "    print(f\"[INFO] Loaded {len(all_records)} existing records from {dataset}.txt\")\n",
    "    \n",
    "    for i in range(remaining):\n",
    "        \n",
    "        current_index = start_index + i\n",
    "        save_path = f\"{GEN_DIR}/{dataset}_{current_index}.json\"\n",
    "        \n",
    "        if os.path.exists(save_path):\n",
    "            print(f\"[SKIP] {save_path} already exists\")\n",
    "            continue\n",
    "        \n",
    "        print(f\"\\n--- [{dataset}] Batch {i+1}/{remaining} (index={current_index}) ---\")\n",
    "        print(\"--- Generating seed alphas with LLM ---\")\n",
    "        \n",
    "        # 1. LLM Generate\n",
    "        try:\n",
    "            response = generate_seed_expressions(\n",
    "                s, region, universe, dataset,\n",
    "                model='gpt-5-mini-2025-08-07',\n",
    "                alpha_num=SEED_ALPHA_NUM,\n",
    "                top_n_datafields=TOP_N_DATAFIELDS\n",
    "            )\n",
    "        except Exception as e:\n",
    "            print(f\"[ERROR] LLM generation failed: {e}\")\n",
    "            continue\n",
    "        \n",
    "        print(\"--- Received response ---\")\n",
    "        \n",
    "        # 2. Parse JSON\n",
    "        try:\n",
    "            json_response = llm.cut_first_to_last_brace(response)\n",
    "            alphas = json.loads(json_response)\n",
    "        except Exception as e:\n",
    "            print(f\"[ERROR] JSON parsing failed: {e}\")\n",
    "            continue\n",
    "        \n",
    "        # 3. Save raw JSON\n",
    "        if not save_json_safe(alphas, save_path):\n",
    "            print(f\"[WARN] Could not save {save_path}, skipping\")\n",
    "            continue\n",
    "        print(f\"[SAVED] {save_path}\")\n",
    "        \n",
    "        # 4. Filter with is_valid_seed_alpha (BEFORE simulation to save API calls)\n",
    "        raw_results = alphas.get(\"results\", [])\n",
    "        seed_candidates = []\n",
    "        rejected = 0\n",
    "        \n",
    "        for x in raw_results:\n",
    "            expr = x.get('implementation', '')\n",
    "            valid, reason = is_valid_seed_alpha(expr)\n",
    "            if valid:\n",
    "                seed_candidates.append(x)\n",
    "            else:\n",
    "                rejected += 1\n",
    "                # Uncomment for debug:\n",
    "                # print(f\"  [REJECT] {reason}: {expr[:80]}\")\n",
    "        \n",
    "        print(f\"[FILTER] {len(seed_candidates)} valid seeds, {rejected} rejected out of {len(raw_results)}\")\n",
    "        \n",
    "        if len(seed_candidates) == 0:\n",
    "            print(f\"[WARN] No valid seed alphas after filtering\")\n",
    "            continue\n",
    "        \n",
    "        # 5. Build alpha list for simulation\n",
    "        alpha_list = [\n",
    "            ace.generate_alpha(\n",
    "                regular=x['implementation'],\n",
    "                region=region,\n",
    "                universe=universe,\n",
    "                neutralization=\"INDUSTRY\"\n",
    "            )\n",
    "            for x in seed_candidates\n",
    "        ]\n",
    "        \n",
    "        tags_list = [\n",
    "            ['seed_alpha', f\"confidence_{x.get('confidence_level', 0)}\"]\n",
    "            for x in seed_candidates\n",
    "        ]\n",
    "        descs_list = [x.get('description', '') for x in seed_candidates]\n",
    "        \n",
    "        len_alpha_list = len(alpha_list)\n",
    "        print(f\"[INFO] Simulating {len_alpha_list} seed alphas\")\n",
    "        \n",
    "        # 6. Simulate in 8-alpha batches\n",
    "        for rep in range(0, len_alpha_list, 8):\n",
    "            \n",
    "            # Session timeout check\n",
    "            if ace.check_session_timeout(s) < 500:\n",
    "                print(\"[INFO] Session timeout approaching, refreshing...\")\n",
    "                s = ace.start_session()\n",
    "            \n",
    "            batch_end = min(rep + 8, len_alpha_list)\n",
    "            \n",
    "            try:\n",
    "                print(f\"--- Simulating batch {rep} to {batch_end} ---\")\n",
    "                \n",
    "                sim_results = list(\n",
    "                    ace.multi_simulate_alphas_map(\n",
    "                        s,\n",
    "                        alpha_list[rep:batch_end],\n",
    "                        tags_list[rep:batch_end],\n",
    "                        descs_list[rep:batch_end],\n",
    "                        batch_end - rep\n",
    "                    )\n",
    "                )\n",
    "                \n",
    "                # Extract records and track selection stats\n",
    "                batch_total = 0\n",
    "                batch_saved = 0\n",
    "                for result in sim_results:\n",
    "                    record = extract_sim_record(result)\n",
    "                    if record:\n",
    "                        batch_total += 1\n",
    "                        all_records.append(record)\n",
    "                        if should_save_alpha(record):\n",
    "                            batch_saved += 1\n",
    "                \n",
    "                print(f\"  [SELECT] {batch_saved}/{batch_total} pass selection (sharpe>1.5, fail<=1)\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"[ERROR] Simulation failed: {e}\")\n",
    "                continue\n",
    "        \n",
    "        # 7. Write sorted, filtered, deduplicated .txt after each LLM batch\n",
    "        #    write_dataset_txt handles: filter → dedup by expression → sort → rewrite\n",
    "        write_dataset_txt(dataset, all_records, region, universe, OUTPUT_DIR)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"[DONE] All datasets processed\")\n",
    "print(\"=\"*60)"
   ]
  }
 ],
