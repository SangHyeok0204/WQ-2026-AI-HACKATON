      "Exploring datasets: ['model138']\n"
     ]
    }
   ],
   "source": [
    "# 🔧 REGION / UNIVERSE GLOBALIZED - 글로벌 변수 사용\n",
    "region = REGION\n",
    "universe = UNIVERSE\n",
    "\n",
    "# 탐색할 dataset 직접 지정 (TARGET_DATASET_IDS 사용)\n",
    "ALLOWED_DATASETS = TARGET_DATASET_IDS\n",
    "\n",
    "# Brain API에서 전체 datasets 정보 가져오기\n",
    "datasets = ace.get_datasets(s, region=region, universe=universe)\n",
    "datasets = datasets.drop_duplicates(['id'])\n",
    "\n",
    "# ALLOWED_DATASETS에 있는 것만 datasets_dict에 포함\n",
    "datasets_filtered = datasets[datasets['id'].isin(ALLOWED_DATASETS)]\n",
    "datasets_dict = {row['id']: row.to_dict() for _, row in datasets_filtered.iterrows()}\n",
    "\n",
    "# datasets_list는 ALLOWED_DATASETS 그대로 사용\n",
    "datasets_list = ALLOWED_DATASETS\n",
    "\n",
    "print(f\"Exploring datasets: {datasets_list}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0d2053c8",
   "metadata": {},
   "source": [
    "## 시뮬레이션 하기에 앞서...\n",
    "* 저카운트와 필드카운트에 따라 몇번 expression을 생성하고 돌릴지 결정 \n",
    "* llm으로 만드는 알파들을 따로 json으로 저장\n",
    "* csv 로드하고 저장하는 함수"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "7949f887",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# Seed-Alpha Pipeline: Utility Functions\n",
    "# ============================================================\n",
    "\n",
    "HELPER_FIELDS = {'cap', 'industry', 'sector', 'subindustry'}\n",
    "\n",
    "\n",
    "def dataset_to_simnum(dataset):\n",
    "    \"\"\"Calculate batch count based on dataset popularity.\"\"\"\n",
    "    score = int(np.log10(datasets_dict[dataset]['userCount'] + 1) + datasets_dict[dataset]['fieldCount'])\n",
    "    if score <= 3:\n",
    "        return 1\n",
    "    elif score <= 10:\n",
    "        return 2\n",
    "    elif score <= 50:\n",
    "        return 3\n",
    "    elif score <= 100:\n",
    "        return 10\n",
    "    else:\n",
    "        return 20\n",
    "\n",
    "\n",
    "def is_valid_seed_alpha(expression):\n",
    "    \"\"\"\n",
    "    Validate that an expression conforms to seed-alpha structural rules.\n",
    "\n",
    "    Rules:\n",
    "    - Must pass sanity_checker() type validation\n",
    "    - Max tree depth: 3\n",
    "    - Max operator count: 3\n",
    "    - Only 1 unique non-helper datafield\n",
    "\n",
    "    Returns: (bool, reason_string)\n",
    "    \"\"\"\n",
    "    if not sanity_checker(expression):\n",
    "        return (False, \"failed sanity_checker type validation\")\n",
    "\n",
    "    try:\n",
    "        root = tree_node(expression)\n",
    "    except Exception as e:\n",
    "        return (False, f\"parse error: {e}\")\n",
    "\n",
    "    all_nodes = root.collect_all_nodes()\n",
    "    for node in all_nodes:\n",
    "        classify_node(node)\n",
    "\n",
    "    depth = root.calculate_depth()\n",
    "    if depth > 3:\n",
    "        return (False, f\"depth {depth} > 3\")\n",
    "\n",
    "    op_nodes = [n for n in all_nodes if n.node_type == 'operator']\n",
    "    if len(op_nodes) > 3:\n",
    "        return (False, f\"operator count {len(op_nodes)} > 3\")\n",
    "\n",
    "    df_nodes = [n for n in all_nodes if n.node_type == 'datafield']\n",
    "    signal_fields = set()\n",
    "    for n in df_nodes:\n",
    "        field_name = n.value.lower()\n",
    "        if field_name not in HELPER_FIELDS and field_name != 'nan':\n",
    "            signal_fields.add(field_name)\n",
    "\n",
    "    if len(signal_fields) == 0:\n",
    "        return (False, \"no signal datafield found\")\n",
    "    if len(signal_fields) > 1:\n",
    "        return (False, f\"multiple signal datafields: {signal_fields}\")\n",
    "\n",
    "    return (True, \"valid seed alpha\")\n",
    "\n",
    "\n",
    "def should_save_alpha(record):\n",
    "    \"\"\"Check if alpha meets selection criteria: sharpe > 1.5 AND fail_count <= 1.\"\"\"\n",
    "    if record is None:\n",
    "        return False\n",
    "    sharpe = record.get('sharpe', 0)\n",
    "    if sharpe is None:\n",
    "        sharpe = 0\n",
    "    fail_count = record.get('fail_count', 99)\n",
    "    return sharpe > 1.5 and fail_count <= 1\n",
    "\n",
    "\n",
    "def _safe_float(val):\n",
    "    \"\"\"Convert a value to float safely, returning 0.0 for None or invalid.\"\"\"\n",
    "    if val is None:\n",
    "        return 0.0\n",
    "    try:\n",
    "        return float(val)\n",
    "    except (ValueError, TypeError):\n",
    "        return 0.0\n",
    "\n",
    "\n",
    "def extract_sim_record(sim_result):\n",
    "    \"\"\"Extract structured dict from Brain API simulation result.\"\"\"\n",
    "    if not isinstance(sim_result, dict) or 'id' not in sim_result:\n",
    "        return None\n",
    "\n",
    "    is_data = sim_result.get('is', {})\n",
    "    if not is_data:\n",
    "        return None\n",
    "\n",
    "    checks = is_data.get('checks', [])\n",
    "    failed = [c.get('name', '') for c in checks if c.get('result') == 'FAIL']\n",
    "    warnings = [c.get('name', '') for c in checks\n",
    "                if c.get('result') not in ('PASS', 'FAIL') and c.get('result')]\n",
    "\n",
    "    for source in (is_data, sim_result):\n",
    "        extra_w = source.get('warnings')\n",
    "        if isinstance(extra_w, list):\n",
    "            warnings.extend(str(w) for w in extra_w)\n",
    "\n",
    "    settings = sim_result.get('settings', {})\n",
    "\n",
    "    return {\n",
    "        'alpha_id': sim_result['id'],\n",
    "        'region': settings.get('region', ''),\n",
    "        'universe': settings.get('universe', ''),\n",
    "        'sharpe': is_data.get('sharpe', 0),\n",
    "        'fitness': is_data.get('fitness', 0),\n",
    "        'turnover': is_data.get('turnover', 0),\n",
    "        'expression': sim_result.get('regular', {}).get('code', ''),\n",
    "        'fail_count': len(failed),\n",
    "        'failed_checks': failed,\n",
    "        'warnings': warnings,\n",
    "    }\n",
    "\n",
    "\n",
    "def format_alpha_entry(idx, record):\n",
    "    \"\"\"Format one alpha record into block format for {dataset}.txt.\"\"\"\n",
    "    fail_count = record.get('fail_count', 0)\n",
    "    failed = record.get('failed_checks', [])\n",
    "    warnings = record.get('warnings', [])\n",
    "    label = \"PASS\" if fail_count == 0 else \"FAIL\"\n",
    "\n",
    "    lines = [\n",
    "        '-' * 48,\n",
    "        f\"--- #{idx} | FAIL: {fail_count} ({label}) ---\",\n",
    "        f\"ID: {record.get('alpha_id', 'N/A')}\",\n",
    "        f\"Region: {record.get('region', '')}, Universe: {record.get('universe', '')}\",\n",
    "        f\"Sharpe: {record.get('sharpe', 0)}, Fitness: {record.get('fitness', 0)}, Turnover: {record.get('turnover', 0)}\",\n",
    "        f\"Expression: {record.get('expression', '')}\",\n",
    "    ]\n",
    "\n",
    "    status_line = f\"Status: {label}\"\n",
    "    if warnings:\n",
    "        status_line += f\" (WARNINGS: {', '.join(warnings)})\"\n",
    "    if failed:\n",
    "        status_line += f\" (FAIL_REASONS: {', '.join(failed)})\"\n",
    "    lines.append(status_line)\n",
    "    lines.append('-' * 48)\n",
    "\n",
    "    return '\\n'.join(lines)\n",
    "\n",
    "\n",
    "def load_existing_txt_records(dataset, output_dir='.'):\n",
    "    \"\"\"Parse existing {dataset}.txt back into record dicts.\"\"\"\n",
    "    txt_path = os.path.join(output_dir, f\"{dataset}.txt\")\n",
    "    if not os.path.exists(txt_path):\n",
    "        return []\n",
    "\n",
    "    records = []\n",
    "    current = None\n",
    "\n",
    "    with open(txt_path, 'r', encoding='utf-8') as f:\n",
    "        for line in f:\n",
    "            line = line.rstrip('\\n')\n",
    "\n",
    "            if line.startswith('=' * 10) or line.startswith('-' * 10):\n",
    "                continue\n",
    "\n",
    "            m = re.match(r'^--- #\\d+ \\| FAIL: (\\d+)', line)\n",
    "            if m:\n",
    "                if current and current.get('alpha_id'):\n",
    "                    records.append(current)\n",
    "                current = {\n",
    "                    'fail_count': int(m.group(1)),\n",
    "                    'failed_checks': [],\n",
    "                    'warnings': [],\n",
    "                    'alpha_id': '', 'region': '', 'universe': '',\n",
    "                    'sharpe': 0, 'fitness': 0, 'turnover': 0,\n",
    "                    'expression': '',\n",
    "                }\n",
    "                continue\n",
    "\n",
    "            if current is None:\n",
    "                continue\n",
    "\n",
    "            if line.startswith('ID: '):\n",
    "                current['alpha_id'] = line[4:].strip()\n",
    "            elif line.startswith('Region: '):\n",
    "                parts = line.split(', ')\n",
    "                current['region'] = parts[0].replace('Region: ', '').strip()\n",
    "                if len(parts) > 1:\n",
    "                    current['universe'] = parts[1].replace('Universe: ', '').strip()\n",
    "            elif line.startswith('Sharpe: '):\n",
    "                for part in line.split(', '):\n",
    "                    kv = part.split(': ', 1)\n",
    "                    if len(kv) == 2:\n",
    "                        k = kv[0].strip().lower()\n",
    "                        try:\n",
    "                            current[k] = float(kv[1].strip())\n",
    "                        except (ValueError, TypeError):\n",
    "                            current[k] = 0\n",
    "            elif line.startswith('Expression: '):\n",
    "                current['expression'] = line[12:].strip()\n",
    "            elif line.startswith('Status: '):\n",
    "                status_str = line[8:]\n",
    "                warn_match = re.search(r'\\(WARNINGS: ([^)]+)\\)', status_str)\n",
    "                if warn_match:\n",
    "                    current['warnings'] = [w.strip() for w in warn_match.group(1).split(',')]\n",
    "                fail_match = re.search(r'\\(FAIL_REASONS: ([^)]+)\\)', status_str)\n",
    "                if fail_match:\n",
    "                    current['failed_checks'] = [f.strip() for f in fail_match.group(1).split(',')]\n",
    "            elif line.startswith('Failed: '):\n",
    "                current['failed_checks'] = [x.strip() for x in line[8:].split(',')]\n",
    "\n",
    "    if current and current.get('alpha_id'):\n",
    "        records.append(current)\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "def write_dataset_txt(dataset, records, region, universe, output_dir='.'):\n",
    "    \"\"\"Filter, deduplicate, sort, and write entries to {dataset}.txt.\"\"\"\n",
    "    filtered = [r for r in records if should_save_alpha(r)]\n",
    "    filtered.sort(key=lambda r: (r.get('fail_count', 99), -(_safe_float(r.get('sharpe')))))\n",
    "\n",
    "    seen_expr = set()\n",
    "    unique_records = []\n",
    "    for r in filtered:\n",
    "        expr = r.get('expression', '').strip()\n",
    "        if expr and expr not in seen_expr:\n",
    "            seen_expr.add(expr)\n",
    "            unique_records.append(r)\n",
    "\n",
    "    unique_records.sort(key=lambda r: (r.get('fail_count', 99), -(_safe_float(r.get('sharpe')))))\n",
    "\n",
    "    dataset_upper = dataset.upper()\n",
    "    lines = [\n",
    "        '=' * 80,\n",
    "        f\"{dataset_upper} SEED ALPHA LIST (Sorted: fail_count ASC, sharpe DESC)\",\n",
    "        f\"Region: {region}, Universe: {universe}\",\n",
    "        f\"Selection: sharpe > 1.5 AND fail_count <= 1\",\n",
    "        f\"Total: {len(unique_records)} alphas\",\n",
    "        '=' * 80,\n",
    "        '',\n",
    "    ]\n",
    "\n",
    "    for idx, record in enumerate(unique_records, 1):\n",
    "        lines.append(format_alpha_entry(idx, record))\n",
    "        lines.append('')\n",
    "\n",
    "    pass_count = sum(1 for r in unique_records if r.get('fail_count', 0) == 0)\n",
    "    fail1_count = sum(1 for r in unique_records if r.get('fail_count', 0) == 1)\n",
    "    warn_count = sum(1 for r in unique_records if r.get('warnings'))\n",
    "    best_sharpe = max((_safe_float(r.get('sharpe')) for r in unique_records), default=0)\n",
    "\n",
    "    lines.extend([\n",
    "        '=' * 80,\n",
    "        'Summary:',\n",
    "        f\"- Total: {len(unique_records)} alphas\",\n",
    "        f\"- PASS (fail_count=0): {pass_count}\",\n",
    "        f\"- FAIL: 1 (fail_count=1): {fail1_count}\",\n",
    "        f\"- With warnings: {warn_count}\",\n",
    "        f\"- Best Sharpe: {best_sharpe}\",\n",
    "        '=' * 80,\n",
    "    ])\n",
    "\n",
    "    txt_path = os.path.join(output_dir, f\"{dataset}.txt\")\n",
    "    with open(txt_path, 'w', encoding='utf-8') as f:\n",
    "        f.write('\\n'.join(lines))\n",
    "\n",
    "    print(f\"[WRITTEN] {txt_path} ({len(unique_records)} alphas | PASS: {pass_count}, FAIL:1: {fail1_count}, warnings: {warn_count})\")\n",
    "    return unique_records"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1c92e335",
   "metadata": {},
   "source": [
    "# 시뮬레이션 돌리기\n",
    "* 데이터셋에 따라 정해진 횟수에 맞추어 시뮬레이션 돌리기\n",
    "* 원한다면 datasets_list를 조작하여 원하는 데이터셋에 맞추어 돌릴 수 있음"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "0693ee9e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[CONFIG] Region: EUR, Universe: TOP2500\n",
      "[CONFIG] Using top 10 datafields per dataset\n",
      "[CONFIG] Selection: sharpe > 1.5 AND fail_count <= 1\n",
      "[CONFIG] Sorting: fail_count ASC, sharpe DESC | Dedup by expression\n",
      "[CONFIG] Datasets: ['model138']\n",
      "\n",
      "============================================================\n",
      "[DATASET] model138\n",
      "  existing=0  target=20  remaining=20  start_index=0\n",
      "============================================================\n",
      "[INFO] Loaded 0 existing records from model138.txt\n",
      "\n",
      "--- [model138] Batch 1/20 (index=0) ---\n",
      "--- Generating seed alphas with LLM ---\n",
      "[INFO] Selected top 10 datafields for dataset 'model138':\n",
      "  - mdl138_4idpc (alphaCount: 475, type: VECTOR)\n",
      "  - mdl138_3idpc (alphaCount: 241, type: VECTOR)\n",
      "  - mdl138_5idpqc (alphaCount: 215, type: VECTOR)\n",
      "  - mdl138_4idpqc (alphaCount: 185, type: VECTOR)\n",
      "  - mdl138_5idpc (alphaCount: 147, type: VECTOR)\n",
      "  - mdl138_3idpqc (alphaCount: 118, type: VECTOR)\n",
      "  - mdl138_pdi5_cash (alphaCount: 111, type: VECTOR)\n",
      "  - mdl138_dtl_3idp (alphaCount: 90, type: VECTOR)\n",
      "  - mdl138_qpdi4_op_margin (alphaCount: 61, type: VECTOR)\n",
      "  - mdl138_qpdi4_cfo_curr_liab (alphaCount: 56, type: VECTOR)\n",
      "{\n",
      "\"results\":[\n",
      "    {\n",
      "        \"idea\":\"Fill missing values for composite PDI4 vector\",\n",
      "        \"description\":\"Pattern: Backfill. Datafield: mdl138_4idpc (VECTOR). Window: 252. Use ts_backfill to fill gaps due to low coverage (<0.6) before downstream use.\",\n",
      "        \"implementation\":\"ts_backfill(vec_avg(mdl138_4idpc), 252)\",\n",
      "        \"confidence_level\":0.92\n",
      "    },\n",
      "    {\n",
      "        \"idea\":\"Normalize recent behavior of composite PDI4\",\n",
      "        \"description\":\"Pattern: Time-series Z-score. Datafield: mdl138_4idpc (VECTOR). Window: 63. Use ts_zscore on vec_avg to normalize recent deviations.\",\n",
      "        \"implementation\":\"ts_zscore(vec_avg(mdl138_4idpc), 63)\",\n",
      "        \"confidence_level\":0.9\n",
      "    },\n",
      "    {\n",
      "        \"idea\":\"Cross-sectional rank of PDI4 composite\",\n",
      "        \"description\":\"Pattern: Cross-sectional Scale Normalization (rank). Datafield: mdl138_4idpc (VECTOR). No time window. Use rank(vec_avg(...)) to remove scale differences across names.\",\n",
      "        \"implementation\":\"rank(vec_avg(mdl138_4idpc))\",\n",
      "        \"confidence_level\":0.88\n",
      "    },\n",
      "    {\n",
      "        \"idea\":\"Within-bucket zscore normalization of PDI4\",\n",
      "        \"description\":\"Pattern: Bucket-based Group Normalization. Datafield: mdl138_4idpc (VECTOR). Group: bucket(rank(vec_avg(mdl138_4idpc)), buckets=10). Normalize within 10 buckets to reduce concentration.\",\n",
      "        \"implementation\":\"group_zscore(vec_avg(mdl138_4idpc), bucket(rank(vec_avg(mdl138_4idpc)), buckets=10))\",\n",
      "        \"confidence_level\":0.82\n",
      "    },\n",
